# 复制本文件为 .env，并填入你的真实 Key
# cp .env.example .env

# ===== 选择一个模型供应商，填对应的 KEY 和 BASE_URL =====

# 方案 A：DeepSeek（推荐，便宜、兼容 OpenAI 接口）
# 注册并获取 key: https://platform.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 方案 B：通义千问（阿里云 DashScope 兼容模式）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 方案 C：智谱 GLM
# LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# 方案 D：OpenAI 官方
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ===== 抠图模型（可选）=====
# 默认 u2net（效果好，约 170MB，抠图峰值内存 ~1GB）
# 低内存服务器(如 2G)建议改用轻量版，省内存、模型仅 4MB：
# REMBG_MODEL=u2netp
